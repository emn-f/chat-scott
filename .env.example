# ============================================================
# Chat Scott - Configuracoes de Ambiente (Java RMI)
# ============================================================
# Copie este arquivo para '.env' e ajuste conforme necessario:
# cp .env.example .env (Linux/macOS) ou Copy-Item .env.example .env (Windows)

# Porta do RMI Registry (Padrao: 1099)
CHAT_PORT=1099

# Host ou IP do servidor RMI (Padrao: localhost)
# Para conexoes em rede local, defina o IP da maquina servidora (ex: 10.8.185.5)
CHAT_HOST=localhost

# Nome do servico publicado no RMI Registry (Padrao: ChatService)
CHAT_SERVICE_NAME=ChatService

# (Opcional - Servidor) IP real da maquina servidora para java.rmi.server.hostname
# Se descomentado, o servidor usara esse IP no stub remoto RMI
# CHAT_SERVER_IP=10.8.185.5
